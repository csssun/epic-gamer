# For local development only; GitHub Actions uses repository Secrets.
EPIC_EMAIL=you@example.com
EPIC_PASSWORD=
NEW_API_BASE_URL=https://your-newapi.example/v1
NEW_API_API_KEY=
# Exact model name exposed by your New API token/channel; must support images.
NEW_API_MODEL=
NEW_API_RESPONSE_FORMAT=json_object
NEW_API_TIMEOUT=90
EPIC_COUNTRY=CN
HEADLESS=true
ENABLE_APSCHEDULER=false
SAVE_SCREENSHOTS=false
TASK_TIMEOUT_SECONDS=900
LOGIN_TIMEOUT_SECONDS=180
CAPTCHA_TIMEOUT_SECONDS=180
